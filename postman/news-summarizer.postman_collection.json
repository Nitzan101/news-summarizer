        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns a page', () => { const b = pm.response.json(); pm.expect(b.items).to.have.lengthOf(3); pm.expect(b.total).to.be.at.least(3); });"
