    {
      "name": "List articles - invalid page size",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/articles?size=500",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "articles"
          ],
          "query": [
            {
              "key": "size",
              "value": "500"
            }
          ]
        },
        "description": "`size` above 100 is rejected before the handler runs."
      },
      "response": [
        {
          "name": "422 Unprocessable Entity",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/articles?size=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "articles"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "500"
                }
              ]
            },
            "description": "`size` above 100 is rejected before the handler runs."
          },
          "status": "Unprocessable Entity",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"detail\": [\n    {\n      \"type\": \"less_than_equal\",\n      \"loc\": [\n        \"query\",\n        \"size\"\n      ],\n      \"msg\": \"Input should be less than or equal to 100\",\n      \"input\": \"500\",\n      \"ctx\": {\n        \"le\": 100\n      }\n    }\n  ]\n}"
        }
      ]
